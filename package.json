  },
  "dependencies": {
    "@remotion/cli": "4.0.545",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.545"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
